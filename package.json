{
  "name": "@yanchha/dsh-devquest",
  "version": "9.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Yanchha",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "gamification",
    "rpg"
  ],
  "description": "Turn your DeepSeek Harness sessions into an RPG: XP, 217 gear pieces across 9 rarities, a pixel battle arena, daily/weekly/season bosses, achievements, synthesis, set bonuses, affixes, talents and rebirth.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yanchha/dsh-devquest.git"
  },
  "homepage": "https://github.com/Yanchha/dsh-devquest#readme",
  "bugs": {
    "url": "https://github.com/Yanchha/dsh-devquest/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./README.md": "./README.md"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
